.result { min-height: 100vh; padding: 120rpx 48rpx 80rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; background: #fff; }
.title { margin-top: 24rpx; font-size: 36rpx; font-weight: 600; color: #111; }
.desc { margin-top: 8rpx; font-size: 28rpx; color: #666; }
.meta { width: 100%; margin-top: 40rpx; padding: 24rpx; background: #f7f8fa; border-radius: 16rpx; }
.meta-item { font-size: 28rpx; color: #333; line-height: 1.8; }
.label { color: #888; }
.actions { width: 100%; margin-top: 60rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.btn { height: 88rpx; border-radius: 999rpx; font-size: 30rpx; display: flex; align-items: center; justify-content: center; }
.primary { background: #07c160; color: #fff; border: none; }
.plain { background: #fff; color: #07c160; border: 2rpx solid #07c160; }