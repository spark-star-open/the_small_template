<!-- pages/survey/survey.wxml -->
<view class="container">
  <!-- 顶部封面 -->
  <view class="header">
    <image class="cover-icon" src="/images/logo.jpg" mode="aspectFit"></image>
  </view>

  <!-- 标题 -->
  <view class="title-section">
    <text class="main-title">防火门项目勘察现场记录表</text>
  </view>

  <!-- 操作按钮 -->
  <view class="button-group">
    <view class="btn-item" bindtap="onTimingRepeat">
      <text class="btn-icon">+</text>
      <text class="btn-text">定时和重复</text>
    </view>
    <view class="btn-item" bindtap="onWriteList">
      <text class="btn-icon">+</text>
      <text class="btn-text">填写名单</text>
    </view>
    <view class="btn-item" bindtap="onEndPage">
      <text class="btn-icon">+</text>
      <text class="btn-text">结束页</text>
    </view>
  </view>

  <!-- 基本信息表单 -->
  <view class="form-section">
    <view class="section-title">基本信息</view>

    <!-- 01 项目技术人员 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">01</text>
        <text class="label-text">项目技术人员</text>
      </view>
      <input class="form-input" placeholder="待填写人输入" value="{{formData.technician}}" bindinput="onInputChange" data-field="technician" />
    </view>

    <!-- 02 用户单位负责人 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">02</text>
        <text class="label-text">用户单位负责人</text>
      </view>
      <input class="form-input" placeholder="待填写人输入" value="{{formData.unitLeader}}" bindinput="onInputChange" data-field="unitLeader" />
    </view>

    <!-- 03 项目编号 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">03</text>
        <text class="label-text">项目编号</text>
      </view>
      <input class="form-input" placeholder="待填写人输入" value="{{formData.projectCode}}" bindinput="onInputChange" data-field="projectCode" />
    </view>

    <!-- 04 商家店名 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">04</text>
        <text class="label-text">商家店名</text>
      </view>
      <input class="form-input" placeholder="待填写人输入" value="{{formData.shopName}}" bindinput="onInputChange" data-field="shopName" />
    </view>

    <!-- 05 地点 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">05</text>
        <text class="label-text">地点</text>
      </view>
      <view class="location-input" bindtap="onChooseLocation">
        <image class="location-icon" src="/images/location-icon.png" mode="aspectFit"></image>
        <text class="location-text">{{formData.location || '请选择地点'}}</text>
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 06 店家正面照片 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">06</text>
        <text class="label-text">店家正面照片</text>
      </view>
      <view class="photo-upload">
        <view class="photo-list">
          <block wx:for="{{formData.shopPhotos}}" wx:key="index">
            <view class="photo-item">
              <image class="photo-img" src="{{item}}" mode="aspectFill"></image>
              <view class="photo-delete" bindtap="onDeletePhoto" data-index="{{index}}" data-field="shopPhotos">×</view>
            </view>
          </block>
          <view class="photo-add" wx:if="{{formData.shopPhotos.length < 6}}" bindtap="onChooseImage" data-field="shopPhotos">
            <text class="add-icon">+</text>
            <text class="add-text">待填写人添加图片</text>
          </view>
        </view>
        <text class="photo-tip">图片要求：最少1张，最多6张</text>
      </view>
    </view>
  </view>

  <!-- 防火门 -->
  <view class="form-section">
    <view class="section-title">防火门</view>

    <!-- 07 原防火门是否需要拆除 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">07</text>
        <text class="label-text">原防火门是否需要拆除</text>
      </view>
      <radio-group bindchange="onRadioChange" data-field="needRemove">
        <label class="radio-item">
          <radio value="yes" checked="{{formData.needRemove === 'yes'}}"/>
          <text class="radio-text">是</text>
        </label>
        <label class="radio-item">
          <radio value="no" checked="{{formData.needRemove === 'no'}}"/>
          <text class="radio-text">否</text>
        </label>
      </radio-group>
    </view>

  <!-- 08 防火门1 -->
    <view class="form-item door-group">
      <view class="form-label">
        <text class="label-num">08</text>
        <text class="label-text">防火门1</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <view class="sub-item">
        <view class="sub-label">防火门高度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.door1Height}}" bindinput="onInputChange" data-field="door1Height" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火门宽度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.door1Width}}" bindinput="onInputChange" data-field="door1Width" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火门开启方向</view>
        <input class="form-input" placeholder="请输入开启方向" value="{{formData.door1Open}}" bindinput="onInputChange" data-field="door1Open" />
      </view>
    </view>

    <!-- 09 防火门2 -->
    <view class="form-item door-group">
      <view class="form-label">
        <text class="label-num">09</text>
        <text class="label-text">防火门2</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <view class="sub-item">
        <view class="sub-label">防火门高度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.door2Height}}" bindinput="onInputChange" data-field="door2Height" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火门宽度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.door2Width}}" bindinput="onInputChange" data-field="door2Width" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火门开启方向</view>
        <input class="form-input" placeholder="请输入开启方向" value="{{formData.door2Open}}" bindinput="onInputChange" data-field="door2Open" />
      </view>
    </view>

    <!-- 10 防火门3 -->
    <view class="form-item door-group">
      <view class="form-label">
        <text class="label-num">10</text>
        <text class="label-text">防火门3</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <view class="sub-item">
        <view class="sub-label">防火门高度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.door3Height}}" bindinput="onInputChange" data-field="door3Height" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火门宽度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.door3Width}}" bindinput="onInputChange" data-field="door3Width" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火门开启方向</view>
        <input class="form-input" placeholder="请输入开启方向" value="{{formData.door3Open}}" bindinput="onInputChange" data-field="door3Open" />
      </view>
    </view>
  </view>

  <!-- 防火窗（3 组：防火窗1/2/3） -->
  <view class="form-section">
    <view class="section-title">防火窗</view>

    <!-- 11 防火窗1 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-num">11</text>
        <text class="label-text">防火窗1</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <view class="sub-item">
        <view class="sub-label">防火窗高度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.window1Height}}" bindinput="onInputChange" data-field="window1Height" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火窗宽度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.window1Width}}" bindinput="onInputChange" data-field="window1Width" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火窗开启方向</view>
        <input class="form-input" placeholder="请输入开启方向" value="{{formData.window1Open}}" bindinput="onInputChange" data-field="window1Open" />
      </view>
    </view>

    <!-- 12 防火窗2 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-num">12</text>
        <text class="label-text">防火窗2</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <view class="sub-item">
        <view class="sub-label">防火窗高度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.window2Height}}" bindinput="onInputChange" data-field="window2Height" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火窗宽度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.window2Width}}" bindinput="onInputChange" data-field="window2Width" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火窗开启方向</view>
        <input class="form-input" placeholder="请输入开启方向" value="{{formData.window2Open}}" bindinput="onInputChange" data-field="window2Open" />
      </view>
    </view>

    <!-- 13 防火窗3 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-num">13</text>
        <text class="label-text">防火窗3</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <view class="sub-item">
        <view class="sub-label">防火窗高度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.window3Height}}" bindinput="onInputChange" data-field="window3Height" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火窗宽度（mm）</view>
        <input class="form-input" type="number" placeholder="请输入数值" value="{{formData.window3Width}}" bindinput="onInputChange" data-field="window3Width" />
      </view>
      <view class="sub-item">
        <view class="sub-label">防火窗开启方向</view>
        <input class="form-input" placeholder="请输入开启方向" value="{{formData.window3Open}}" bindinput="onInputChange" data-field="window3Open" />
      </view>
    </view>
  </view>

  <!-- 吊顶 -->
  <view class="form-section">
    <view class="section-title">吊顶</view>

    <!-- 14 吊顶长度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-num">14</text>
        <text class="label-text">吊顶长度（m）</text>
      </view>
      <input class="form-input" placeholder="请输入数字" type="number" value="{{formData.ceilingLength}}" bindinput="onInputChange" data-field="ceilingLength" />
    </view>

    <!-- 15 吊顶宽度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-num">15</text>
        <text class="label-text">吊顶宽度（m）</text>
      </view>
      <input class="form-input" placeholder="请输入数字" type="number" value="{{formData.ceilingWidth}}" bindinput="onInputChange" data-field="ceilingWidth" />
    </view>
  </view>

  <!-- 防火隔断 -->
  <view class="form-section">
    <view class="section-title">防火隔断</view>

    <!-- 16 防火玻璃隔墙高度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">16</text>
        <text class="label-text">防火玻璃隔墙高度（mm）</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <input class="form-input" type="number" placeholder="请输入数字" value="{{formData.glassWallHeight}}" bindinput="onInputChange" data-field="glassWallHeight" />
    </view>

    <!-- 17 防火玻璃隔墙宽度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">17</text>
        <text class="label-text">防火玻璃隔墙宽度（mm）</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <input class="form-input" type="number" placeholder="请输入数字" value="{{formData.glassWallWidth}}" bindinput="onInputChange" data-field="glassWallWidth" />
    </view>

    <!-- 18 轻钢龙骨隔墙高度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">18</text>
        <text class="label-text">轻钢龙骨隔墙高度（mm）</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <input class="form-input" type="number" placeholder="请输入数字" value="{{formData.lightSteelHeight}}" bindinput="onInputChange" data-field="lightSteelHeight" />
    </view>

    <!-- 19 轻钢龙骨隔墙宽度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">19</text>
        <text class="label-text">轻钢龙骨隔墙宽度（mm）</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <input class="form-input" type="number" placeholder="请输入数字" value="{{formData.lightSteelWidth}}" bindinput="onInputChange" data-field="lightSteelWidth" />
    </view>

    <!-- 20 砌块隔墙高度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">20</text>
        <text class="label-text">砌块隔墙高度（mm）</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <input class="form-input" type="number" placeholder="请输入数字" value="{{formData.blockWallHeight}}" bindinput="onInputChange" data-field="blockWallHeight" />
    </view>

    <!-- 21 砌块隔墙宽度 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-num">21</text>
        <text class="label-text">砌块隔墙宽度（mm）</text>
      </view>
      <view class="measure-hint">没有则填0</view>
      <input class="form-input" type="number" placeholder="请输入数字" value="{{formData.blockWallWidth}}" bindinput="onInputChange" data-field="blockWallWidth" />
    </view>
  </view>

  <!-- 其他 -->
  <view class="form-section">
    <view class="section-title">其他</view>

    <!-- 现场勘察记录表拍照 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-text">现场勘察记录表拍照</text>
      </view>
      <view class="photo-upload">
        <view class="photo-list">
          <block wx:for="{{formData.surveyPhotos}}" wx:key="index">
            <view class="photo-item">
              <image class="photo-img" src="{{item}}" mode="aspectFill"></image>
              <view class="photo-delete" bindtap="onDeletePhoto" data-index="{{index}}" data-field="surveyPhotos">×</view>
            </view>
          </block>
          <view class="photo-add-large" wx:if="{{formData.surveyPhotos.length < 6}}" bindtap="onChooseImage" data-field="surveyPhotos">
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
          </view>
        </view>
        <text class="photo-tip">图片要求：最少1张，最多6张</text>
      </view>
    </view>

    <!-- 店家意向施工时间 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-text">店家意向施工时间</text>
      </view>
      <picker mode="multiSelector" value="{{formData.dateTimeIndex}}" range="{{dateTimeArray}}" bindchange="onDateTimeChange">
        <view class="picker-input">
          <image class="picker-icon" src="/images/time-icon.png" mode="aspectFit"></image>
          <text class="picker-text">{{formData.constructionTime || '请选择时间'}}</text>
          <image class="arrow-icon" src="/images/arrow-down.png" mode="aspectFit"></image>
        </view>
      </picker>
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text class="label-text">备注</text>
      </view>
      <textarea class="form-textarea" placeholder="请输入备注" value="{{formData.remark}}" bindinput="onInputChange" data-field="remark" maxlength="-1"></textarea>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交</button>
  </view>
</view>
