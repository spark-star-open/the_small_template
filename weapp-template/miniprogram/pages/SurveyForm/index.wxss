/* pages/survey/survey.wxss */
page {
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 顶部封面 */
.header {
  background-color: #fff;
  height: 260rpx; /* increased to fit larger logo */
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #e5e5e5;
}

.cover-icon {
  width: 420rpx; /* enlarged logo width */
  height: 110rpx; /* enlarged logo height */
  object-fit: contain;
}

.cover-text { display: none; }

/* 标题区域 */
.title-section {
  background-color: #fff;
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.main-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* 按钮组 */
.button-group {
  background-color: #fff;
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #e5e5e5;
  margin-bottom: 20rpx;
}

.btn-item {
  flex: 1;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-icon {
  font-size: 32rpx;
  color: #666;
}

.btn-text {
  font-size: 26rpx;
  color: #666;
}

/* 表单区域 */
.form-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
}

/* 防火门分组美化 */
.door-group {
  background-color: #fff;
  padding: 30rpx 24rpx 24rpx 24rpx;
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.door-group:last-child {
  border-bottom: none;
}

.door-group .form-label {
  min-width: 180rpx;
  margin-bottom: 25rpx;
}

.door-group .sub-item {
  padding-left: 30rpx;
  border-left: 6rpx solid #f5f5f5;
  margin-bottom: 25rpx;
}

.door-group .sub-label {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.required {
  color: #ff4d4f;
  font-size: 32rpx;
  margin-right: 5rpx;
}

.label-num {
  font-size: 28rpx;
  color: #333;
  margin-right: 10rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.form-section .form-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  min-width: 180rpx;
}

/* 子项目样式 */
.sub-item {
  margin-bottom: 20rpx;
}

.sub-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

/* 测量提示 */
.measure-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #ccc;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 25rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #ccc;
}

/* 单选框组 */
radio-group {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.radio-text {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333;
}

radio {
  transform: scale(1.2);
}

/* 地点选择 */
.location-input {
  display: flex;
  align-items: center;
  height: 80rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 0 30rpx;
}

.location-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 15rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #ccc;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.3;
}

/* 时间选择器 */
.picker-input {
  display: flex;
  align-items: center;
  height: 80rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 0 30rpx;
}

.picker-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 15rpx;
}

.picker-text {
  flex: 1;
  font-size: 28rpx;
  color: #ccc;
}

/* 照片上传 */
.photo-upload {
  width: 100%;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 15rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  background-color: #fafafa;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

/* 大尺寸照片添加框 */
.photo-add-large {
  width: 100%;
  height: 200rpx;
  background-color: #fafafa;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.add-icon {
  font-size: 60rpx;
  color: #ccc;
  line-height: 1;
}

.add-text {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.photo-tip {
  font-size: 24rpx;
  color: #999;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 90rpx;
}

.submit-btn::after {
  border: none;
}
