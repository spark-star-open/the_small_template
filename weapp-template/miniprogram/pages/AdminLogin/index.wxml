<view class="wrap">
  <view class="back-button" bindtap="goHome">
    <image src="/images/arrow-right.png" mode="aspectFit" class="back-icon back-rotate" />
  </view>
  <view class="title">请输入管理者密码</view>

  <view class="field">
    <input class="pwd"
           password="{{!show}}"
           value="{{pwd}}"
           bindinput="onInput"
           placeholder="请输入密码" />
    <text class="toggle" bindtap="toggleShow">{{toggleText}}</text>
  </view>

  <button class="btn primary"
          bindtap="onLogin"
          loading="{{loading}}"
          disabled="{{loading}}">
    登录
  </button>

  <button class="btn secondary" bindtap="goHome">返回主页</button>
</view>
