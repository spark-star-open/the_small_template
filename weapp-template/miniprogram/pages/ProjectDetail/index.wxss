page { background: #f5f6f8; }
.wrap { padding: 24rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.empty { color: #999; margin: 40rpx 0; text-align: center; }
.item { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.time { color: #666; font-size: 26rpx; }
.status { color: #07c160; font-size: 26rpx; }
.elli { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.btn.add { background: #07c160; color: #fff; }
.btn.danger { background: #fa5151; color: #fff; margin-top: 12rpx; }
.ops { display: flex; justify-content: flex-end; }

.nav{position:relative;height:88rpx;display:flex;align-items:center;}
.back{position:absolute;left:12rpx;top:0;width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center}
.icon{width:44rpx;height:44rpx}
.back-rotate{transform:rotate(180deg)}
.nav-title{flex:1;text-align:center;font-size:32rpx;font-weight:600}

