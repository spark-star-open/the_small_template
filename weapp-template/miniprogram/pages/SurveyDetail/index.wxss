page { background: #f5f6f8; }
.wrap { padding: 24rpx; }
.nav{position:relative;height:88rpx;display:flex;align-items:center;}
.back{position:absolute;left:12rpx;top:0;width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center}
.icon{width:44rpx;height:44rpx}
.back-rotate{transform:rotate(180deg)}
.nav-title{flex:1;text-align:center;font-size:32rpx;font-weight:600}
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; font-size: 28rpx; }
.label { color: #888; margin-right: 16rpx; }
.section { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.imgs { white-space: nowrap; }
.img { width: 200rpx; height: 200rpx; border-radius: 8rpx; margin-right: 12rpx; background: #f2f3f5; }
.empty { text-align: center; padding: 120rpx 0; color: #999; }

.footer{padding:24rpx}
.btn.primary{background:#07c160;color:#fff;border:none;height:88rpx;border-radius:8rpx}
.done-tip{color:#07c160;text-align:center}
