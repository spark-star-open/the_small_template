.wrap { padding: 24rpx; padding-bottom: 120rpx; position: relative; }
.filters { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.picker { background: #fff; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 26rpx; }
.search { background: #fff; border-radius: 12rpx; padding: 12rpx 16rpx; font-size: 26rpx; flex: 1; }
.item { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.row-left { display: flex; align-items: center; }
.row-right { display: flex; align-items: center; gap: 12rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.sub { color: #888; margin-top: 8rpx; font-size: 26rpx; }
.badge { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 999rpx; background: #eee; color: #333; }
.badge.done { background: #e8f8ee; color: #0aa344; }
.badge.pending { background: #fff6e5; color: #cc7a00; }
.img-btn { background: #f3f4f6; color: #333; border: none; padding: 6rpx 14rpx; border-radius: 8rpx; font-size: 24rpx; }
.loadmore { text-align: center; color: #888; padding: 24rpx 0; }
.empty { text-align: center; color: #999; padding: 120rpx 0; }

/* 选择小圆点 */
.radio { width: 28rpx; height: 28rpx; border-radius: 50%; margin-right: 12rpx; background: #e6e6e6; border: 2rpx solid #dcdcdc; box-sizing: border-box; }
.radio.on { background: #07c160; border-color: #07c160; }

/* inline export button inside filters */
.export-btn { background: linear-gradient(90deg,#06c25b,#07c160); color: #fff; border: none; padding: 8rpx 12rpx; border-radius: 6rpx; font-size: 24rpx; box-shadow: 0 4rpx 12rpx rgba(6,194,104,0.12); align-self: center; }

/* bottom action bar */
.bottom-bar { position: fixed; left: 16rpx; right: 16rpx; bottom: 18rpx; display: flex; justify-content: space-between; gap: 16rpx; align-items: center; }
.bottom-btn { flex: 1; background: #fff; color: #111; border: 1rpx solid #ddd; border-radius: 12rpx; height: 88rpx; font-size: 28rpx; }
.bottom-btn + .bottom-btn { margin-left: 0; }

/* ensure content not covered: add extra spacing at bottom via wrap padding-bottom */

/* 长条导出按钮（显示在“没有更多了”下方） */
.export-long { display: block; width: 100%; height: 96rpx; margin: 16rpx 0; border-radius: 12rpx; background: linear-gradient(90deg,#06c25b,#07c160); color: #fff; font-size: 32rpx; border: none; box-shadow: 0 6rpx 18rpx rgba(6,194,104,0.12); display:flex; align-items:center; justify-content:center; }

.export-msg { text-align: center; color: #888; font-size: 24rpx; margin: 8rpx 0 4rpx; }
.export-tip { text-align: center; color: #999; font-size: 24rpx; margin-top: 6rpx; }
.link-btn { display:block; margin: 4rpx auto 8rpx; padding: 0 20rpx; height: 64rpx; line-height: 64rpx; font-size: 26rpx; color: #07c160; background: #f6fffa; border: 1rpx solid #b7eb8f; border-radius: 10rpx; width: 60%; }
.export-link { color: #06c25b; text-decoration: underline; }

/* 顶部操作条（导出上方） */
.ops-bar { display: flex; gap: 16rpx; margin: 8rpx 0 8rpx; }
.ops-btn { flex: 1; height: 72rpx; border-radius: 10rpx; background: #fff; border: 1rpx solid #ddd; font-size: 28rpx; }
.ops-btn.danger { color: #e54d42; border-color: #f5b1ac; }
