<view class="wrap">
  <view class="filters">
    <picker mode="selector" range="{{dateRangeOptions}}" value="{{dateRangeIndex}}" bindchange="onDateRange">
      <view class="picker">日期：{{dateRangeOptions[dateRangeIndex]}}</view>
    </picker>
    <input class="search" value="{{filters.keyword}}" bindinput="onKeyword" placeholder="门店/项目编号" />
  </view>

  <block wx:if="{{list.length}}">
    <block wx:for="{{list}}" wx:key="_id">
      <view class="item" bindtap="goDetail" data-id="{{item._id}}">
        <view class="row">
          <view class="row-left">
            <view wx:if="{{selectMode}}" class="radio {{ selectedMap[item._id] ? 'on' : '' }}" data-id="{{item._id}}" catchtap="toggleSelect"></view>
            <text class="title">{{item.shopName}}</text>
          </view>
          <view class="row-right">
            <button class="img-btn" catchtap="onImageMenu" data-id="{{item._id}}">图片</button>
            <text class="badge {{item.status}}">{{item.statusText}}</text>
          </view>
        </view>
        <view class="sub">{{item.projectCode}} · {{item.timeText}}</view>
      </view>
    </block>
    <view class="loadmore" wx:if="{{loading}}">加载中...</view>
    <view class="loadmore" wx:if="{{!hasMore && !loading}}">没有更多</view>
    <!-- 操作条：全部标为已读 + 清除 -->
    <view class="ops-bar" wx:if="{{!hasMore && !loading}}">
      <button class="ops-btn" bindtap="markAllRead">全部标为已读</button>
      <button class="ops-btn danger" bindtap="onClearTap">{{ selectMode ? (selectedIds.length ? '清除(' + selectedIds.length + ')' : '清除') : '清除' }}</button>
    </view>
    <button class="export-long" wx:if="{{!hasMore && !loading}}" bindtap="exportExcel">{{ exportMode ? (selectedIds.length ? ('导出所选(' + selectedIds.length + ')') : '取消导出') : '导出 Excel' }}</button>
    <view class="export-tip" wx:if="{{exportMode}}">导出模式：点左侧圆点多选，再点上方按钮导出</view>
    <view class="export-msg" wx:if="{{exportNotice}}">
      <text>已生成文件：</text>
      <text class="export-link" bindtap="onExportLinkTap">{{exportFileName || exportNotice}}</text>
    </view>
    <button class="link-btn" wx:if="{{exportNotice && (exportTempURL || exportFileID)}}" bindtap="downloadExport">下载到本地</button>
  </block>
  <view class="empty" wx:else>暂无数据</view>

  <view class="bottom-bar">
    <button class="bottom-btn" bindtap="refresh">刷新</button>
    <button class="bottom-btn" bindtap="goAnalytics">统计概览</button>
    <button class="bottom-btn" bindtap="goHome">返回主页</button>
  </view>
</view>
