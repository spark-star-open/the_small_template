        </div>
        <div class="measure-hint">没有则填0</div>
        <input class="form-input" type="number" placeholder="请输入数字" onchange="updateProgress()">
      </div>

      <div class="form-item">
        <div class="form-label">
          <span class="required">*</span>
          <span class="label-num">20</span>
          <span class="label-text">砌块隔墙高度（mm）</span>
        </div>
        <input class="form-input" type="number" placeholder="请输入数字" onchange="updateProgress()">
      </div>

      <div class="form-item">
        <div class="form-label">
          <span class="required">*</span>
          <span class="label-num">21</span>
          <span class="label-text">砌块隔墙宽度（mm）</span>
        </div>
        <input class="form-input" type="number" placeholder="请输入数字" onchange="updateProgress()">
