    <!-- 防火隔断 -->
    <div class="form-section">
      <div class="section-title">防火隔断</div>

      <div class="form-item">
        <div class="form-label">
          <span class="required">*</span>
          <span class="label-num">16</span>
          <span class="label-text">防火玻璃隔墙高度（mm）</span>
